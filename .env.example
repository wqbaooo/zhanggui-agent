# ============================================================
# 开店 Agent v3.0 — 环境变量模板
# ============================================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
# ============================================================

# ===== LLM 配置（至少填一个） =====

# DeepSeek API（推荐，激活 LangGraph/ReAct 模式）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API（DeepSeek 不可用时的降级方案）
# OPENAI_API_KEY=sk-your-openai-api-key

# ===== 高德地图（商圈选址分析，可选） =====
# 申请地址: https://lbs.amap.com/api/webservice/create-project-and-key
# AMAP_WEBSERVICE_KEY=your-amap-key
# AMAP_REQUEST_INTERVAL=0.35

# ===== 联网搜索（可选，默认 DuckDuckGo） =====
# SEARCH_BACKEND=auto
# 备选后端（需要对应 API key）
# SERPER_API_KEY=your-serper-key
# TAVILY_API_KEY=your-tavily-key
