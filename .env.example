# ============================================================
# 开店 Agent v3.0 — 环境变量模板
# ============================================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
# ============================================================

# ===== LLM 配置（至少填一个） =====

# DeepSeek API（推荐，激活 LangGraph/ReAct 模式）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === 可选：Hermes 统一 Agent 运行时 ===
# 默认 trusted 表示继续使用当前可信链；Hermes Gateway 验证可用后改为 hermes。
AGENT_RUNTIME=trusted
HERMES_API_BASE=http://127.0.0.1:8652
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_SECONDS=75

# 图片识别需要视觉模型。推荐使用 OpenAI 视觉模型。
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_VISION_MODEL=gpt-4o-mini

# 如果使用兼容 OpenAI SDK 的 DeepSeek/VL 服务，必须单独配置视觉模型。
# DEEPSEEK_VISION_MODEL=deepseek-vl2

# 免费本地图片识别（优先级高于付费视觉模型）
# 需要本机安装 tesseract；若安装 Ollama 视觉模型，会作为 OCR 后的本地兜底。
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_VISION_MODEL=moondream:1.8b

# ===== 高德地图（商圈选址分析，可选） =====
# 申请地址: https://lbs.amap.com/api/webservice/create-project-and-key
# AMAP_WEBSERVICE_KEY=your-amap-key
# AMAP_REQUEST_INTERVAL=0.35

# ===== 联网搜索（可选，默认 DuckDuckGo） =====
# SEARCH_BACKEND=auto
# 备选后端（需要对应 API key）
# SERPER_API_KEY=your-serper-key
# TAVILY_API_KEY=your-tavily-key
